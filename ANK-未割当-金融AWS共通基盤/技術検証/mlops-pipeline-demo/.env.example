# Jupyter Lab の認証設定を必ず行うこと。
# JUPYTER_TOKEN は `openssl rand -hex 24` 等で生成 (短期検証なら token のみで十分)。
# 永続パスワードを設定する場合は JUPYTER_PASSWORD_HASH に argon2 ハッシュを入れる
# (`python -c "from jupyter_server.auth import passwd; print(passwd())"` で生成)。
# 本ファイルはサンプル。実際の `.env` は git に含めないこと。
JUPYTER_TOKEN=replace-with-openssl-rand-hex-24-output
JUPYTER_PASSWORD_HASH=
